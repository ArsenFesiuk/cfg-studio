{
  "homepage": "https://arsenfesiuk.github.io/cfg-studio",
  "name": "cfg-studio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.11",
    "@mui/material": "^5.14.11",
    "antlr4": "^4.13.2",
    "better-react-mathjax": "^2.1.0",
    "framer-motion": "^10.12.16",
    "i18next": "^22.4.9",
    "lucide-react": "^0.297.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^12.3.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "gh-pages": "^6.0.0",
    "kill-port": "^2.0.1",
    "typescript": "4.9.5"
  },
  "scripts": {
    "start": "kill-port 3000 && react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:grammar": "react-scripts test --testPathPattern=grammar --watchAll=false",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "generate:parser": "cd src/utils/grammar && java -jar antlr-4.13.1-complete.jar -Dlanguage=JavaScript -listener -no-visitor -o BNF BNF.g4 && java -jar antlr-4.13.1-complete.jar -Dlanguage=JavaScript -listener -no-visitor -o EBNF EBNF.g4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
